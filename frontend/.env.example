# Yuktha Frontend Public Environment Configuration
# NOTICE: Do NOT put secrets, private keys, database URLs, or JWT secrets in frontend!
# Only public variables prefixed with VITE_ are exposed to the client bundle.

# Backend API Base URL
VITE_API_URL=http://localhost:5000/api

# Optional: Google Analytics 4 Measurement ID (Public tracking ID: G-XXXXXXXXXX)
# VITE_GA_MEASUREMENT_ID=
