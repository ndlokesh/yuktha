// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  COMPANY
  COLLEGE
  ADMIN
}

enum JobType {
  INTERNSHIP
  JOB
}

enum AppStatus {
  APPLIED
  SHORTLISTED
  ACCEPTED
  REJECTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

// ─── Core User ────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  isActive  Boolean  @default(false) // colleges must verify students before activation
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile?
  company Company?
  college College?
}

// ─── Student ──────────────────────────────────────────────────────────────────

model StudentProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    String
  degree         String   // BAMS, BHMS, BUMS, BNYS, B.Sc Yoga, BSMS, DHMS etc.
  graduationYear Int
  city           String
  state          String   @default("")
  resumeUrl      String?
  photoUrl       String?
  linkedinUrl    String?
  achievements   String?
  bio            String?

  skills       StudentSkill[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentSkill {
  studentId String
  skillId   String
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
}

// ─── Skill Taxonomy ───────────────────────────────────────────────────────────

model Skill {
  id       String @id @default(cuid())
  name     String @unique
  system   String // Ayurveda | Yoga & Naturopathy | Unani | Siddha | Homeopathy | Research & Clinical

  students StudentSkill[]
  jobs     JobSkill[]
}

// ─── Company ──────────────────────────────────────────────────────────────────

model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  sector      String   // Ayurveda pharma, Wellness chain, Hospital, Research, etc.
  website     String?
  city        String?
  description String?
  logoUrl     String?

  jobs JobListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── College ──────────────────────────────────────────────────────────────────

model College {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  city               String
  state              String
  affiliation        String?            // University or autonomous
  verificationStatus VerificationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Job Listings ─────────────────────────────────────────────────────────────

model JobListing {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title        String
  description  String
  type         JobType
  location     String
  stipend      String?
  deadline     DateTime
  isActive     Boolean   @default(true)

  skills       JobSkill[]
  applications Application[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model JobSkill {
  jobId   String
  skillId String
  job     JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
}

// ─── Applications ─────────────────────────────────────────────────────────────

model Application {
  id        String    @id @default(cuid())
  studentId String
  jobId     String
  status    AppStatus @default(APPLIED)
  note      String?   // company's note on the applicant

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  job     JobListing     @relation(fields: [jobId], references: [id], onDelete: Cascade)

  appliedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, jobId]) // prevent duplicate applications
}
